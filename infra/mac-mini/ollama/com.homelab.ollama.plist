<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  infra/mac-mini/ollama/com.homelab.ollama.plist

  System LaunchDaemon (installed to /Library/LaunchDaemons by
  setup-ollama-daemon.sh) replacing Homebrew's per-user LaunchAgent
  (sh.brew.ollama). Two reasons:
    - Starts at boot with nobody logged in (a LaunchAgent waits for login,
      and auto-login is off) — survives a power cut unattended.
    - Not regenerated by `brew upgrade` / `brew services`, so the
      OLLAMA_HOST=0.0.0.0 LAN binding below doesn't get silently reverted.

  Runs as the regular user so models stay in ~/.ollama/models (same store
  the Homebrew service already pulled into).
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.homelab.ollama</string>
	<key>UserName</key>
	<string>homelab-mac-01</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/opt/ollama/bin/ollama</string>
		<string>serve</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/homelab-mac-01</string>
		<!-- LAN-reachable, same posture as gpu-node-01's Ollama (ADR 0024): no auth, LAN-only. -->
		<key>OLLAMA_HOST</key>
		<string>0.0.0.0:11434</string>
		<!-- Carried over from Homebrew's plist. -->
		<key>OLLAMA_FLASH_ATTENTION</key>
		<string>1</string>
		<key>OLLAMA_KV_CACHE_TYPE</key>
		<string>q8_0</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>WorkingDirectory</key>
	<string>/opt/homebrew/var</string>
	<key>StandardOutPath</key>
	<string>/opt/homebrew/var/log/ollama.log</string>
	<key>StandardErrorPath</key>
	<string>/opt/homebrew/var/log/ollama.log</string>
</dict>
</plist>
